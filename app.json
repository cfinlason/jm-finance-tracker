{
  "expo": {
    "name": "Allot",
    "slug": "allot",
    "scheme": "allot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.allot.budget",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "backgroundColor": "#0A1512"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14B88A"
        }
      ]
    ],
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    }
  }
}